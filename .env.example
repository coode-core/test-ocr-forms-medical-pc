# Copy to .env (pc setup does it for you)
OPENROUTER_API_KEY=
# Vision model on OpenRouter used for OCR
OCR_MODEL=google/gemini-2.5-flash-lite
# Optional: model used to retry pages with too many flagged cells
OCR_FALLBACK_MODEL=
FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSeVEWX0_CKBJHchjbxwid3fgb35vRtWwSZU1CpaxO3YNoVLQA/viewform
# http (anonymous POST, default) or browser (Playwright with the user's Google session)
SUBMIT_ENGINE=http
SUBMIT_DELAY_SECONDS=1.5
